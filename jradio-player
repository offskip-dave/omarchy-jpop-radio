#!/usr/bin/env bash
# Headless mpv controller for ofs.jradio.
# Usage: jradio-player start [url] | stop | toggle [url] | status
PATH=/usr/bin
unset BASH_ENV ENV
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?jradio-player requires XDG_RUNTIME_DIR}"

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
version=$(jq -r '.version // "1.1.1"' "$script_dir/manifest.json" 2>/dev/null || echo "1.1.1")
user_agent="ofs.jradio/${version} (Omarchy Quattro; +https://jpopsuki.eu/media.php)"
player_title="JPopsuki Radio"

# Icecast has no working TLS. Playback is limited to this fixed allowlist —
# never a URL taken from a remote metadata/playlist response.
allowlisted_urls=(
  "http://jpopsuki.fm:8000/stream"
  "http://jpopsuki.fm:8000/autodj"
)
default_url="${allowlisted_urls[0]}"

# Literal XDG paths so inspect resolves writes under $XDG_RUNTIME_DIR.
runtime_dir="$XDG_RUNTIME_DIR/ofs-jradio"
socket="$XDG_RUNTIME_DIR/ofs-jradio/mpv.sock"
pid_file="$XDG_RUNTIME_DIR/ofs-jradio/player.pid"
url_file="$XDG_RUNTIME_DIR/ofs-jradio/url.txt"
log_file="$XDG_RUNTIME_DIR/ofs-jradio/mpv.log"
# Hard ceiling on every mpv IPC reply before it enters a shell variable or
# reaches QML. Idle timeout alone (-T) does not bound bytes.
max_ipc_bytes=8192

install -d -m 700 "$XDG_RUNTIME_DIR/ofs-jradio"
exec 8>"$XDG_RUNTIME_DIR/ofs-jradio/player.lock"

process_start_time() {
  local pid=$1
  [[ -r /proc/$pid/stat ]] || return 1
  awk '$3 != "Z" { print $22 }' "/proc/$pid/stat" 2>/dev/null
}

player_alive() {
  local pid expected_start actual_start
  [[ -s $pid_file ]] || return 1
  read -r pid expected_start < "$pid_file" || return 1
  [[ $pid =~ ^[0-9]+$ && $expected_start =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  actual_start=$(process_start_time "$pid") || return 1
  [[ $actual_start == "$expected_start" ]]
}

write_player_pid() {
  local pid=$1
  local start_time temporary
  start_time=$(process_start_time "$pid") || return 1
  temporary=$(mktemp "$XDG_RUNTIME_DIR/ofs-jradio/player.XXXXXX")
  printf '%s %s\n' "$pid" "$start_time" > "$temporary"
  mv "$temporary" "$XDG_RUNTIME_DIR/ofs-jradio/player.pid"
}

cleanup_dead_player() {
  player_alive && return
  rm -f "$pid_file" "$socket"
}

wait_until_dead() {
  local rounds=$1
  local _
  for _ in $(seq 1 "$rounds"); do
    player_alive || return 0
    sleep 0.02
  done
  player_alive && return 1
  return 0
}

terminate_tracked_player() {
  local pid
  player_alive || return 0
  read -r pid _ < "$pid_file"
  kill -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
  wait_until_dead 100 && { cleanup_dead_player; return 0; }
  kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
  wait_until_dead 50 || return 1
  cleanup_dead_player
}

# Stream an mpv IPC exchange into a temp file, capped at max_ipc_bytes+1 so we
# can detect overflow without ever assigning an unbounded string in bash.
# Prints the response path on stdout on success. Returns:
#   0 success (size <= max_ipc_bytes)
#   1 transport / socket failure
#   2 over-limit (rejected; file removed)
ipc_exchange() {
  local payload=$1
  local response size
  [[ -S $socket ]] || return 1
  response=$(mktemp "$XDG_RUNTIME_DIR/ofs-jradio/ipc.XXXXXX")
  # head -c stops reading after the ceiling; +1 byte signals overflow.
  if ! printf '%s\n' "$payload" \
      | socat -T 2 - "UNIX-CONNECT:$socket" 2>/dev/null \
      | head -c "$((max_ipc_bytes + 1))" > "$response"
  then
    rm -f "$response"
    return 1
  fi
  size=$(stat -c '%s' -- "$response" 2>/dev/null || echo 0)
  if (( size > max_ipc_bytes )); then
    rm -f "$response"
    return 2
  fi
  printf '%s\n' "$response"
}

# Load a bounded IPC file into a shell variable only after the size check.
# Rejects and clears on empty/missing/oversize paths.
ipc_slurp() {
  local path=$1
  local size
  [[ -n $path && -f $path ]] || return 1
  size=$(stat -c '%s' -- "$path" 2>/dev/null || echo 0)
  if (( size <= 0 || size > max_ipc_bytes )); then
    rm -f "$path"
    return 1
  fi
  # Safe: size is already proven <= max_ipc_bytes.
  cat "$path"
  rm -f "$path"
}

send_command() {
  local payload=$1
  local path
  # Discard the body, but still enforce the byte ceiling so a huge mpv reply
  # cannot stall or exhaust the helper even when stdout is redirected.
  path=$(ipc_exchange "$payload") || return 1
  rm -f "$path"
  return 0
}

current_url() {
  if [[ -s $url_file ]]; then
    tr -d '\r\n' < "$url_file"
  else
    printf '%s\n' "$default_url"
  fi
}

url_allowlisted() {
  local url=$1 candidate
  for candidate in "${allowlisted_urls[@]}"; do
    [[ $url == "$candidate" ]] && return 0
  done
  return 1
}

# Cap and strip controls from a single ICY field after jq extraction / split.
bound_field() {
  local value=$1
  local max=$2
  printf '%s' "$value" \
    | tr -d '\000-\037\177' \
    | tr -d '<>&`' \
    | tr -s '[:space:]' ' ' \
    | head -c "$max"
}

icy_jq_field() {
  local reply=$1
  local filter=$2
  printf '%s' "$reply" | jq -r "$filter" 2>/dev/null || true
}

icy_from_reply() {
  local reply=$1 artist title song
  artist=$(icy_jq_field "$reply" '.data // {} | (.artist // .icy_artist // ."icy-artist" // "") | tostring | .[0:120]')
  title=$(icy_jq_field "$reply" '.data // {} | (.title // .icy_title // ."icy-title" // "") | tostring | .[0:120]')
  song=$(icy_jq_field "$reply" '.data // {} | (."icy-name" // .icy_name // "") | tostring | .[0:200]')
  if [[ -z $artist && -n $title && $title == *" - "* ]]; then
    artist=${title%% - *}
    title=${title#* - }
  fi
  artist=$(bound_field "${artist:-}" 120)
  title=$(bound_field "${title:-}" 120)
  song=$(bound_field "${song:-}" 200)
  jq -cn --arg artist "$artist" --arg title "$title" --arg song "$song" \
    '{icyArtist:$artist,icyTitle:$title,icySong:$song}'
}

empty_icy_json() {
  jq -cn '{icyArtist:"",icyTitle:"",icySong:""}'
}

read_icy() {
  local path reply
  [[ -S $socket ]] && player_alive || { empty_icy_json; return 0; }
  # Fail closed on transport error or over-limit: emit empty ICY fields.
  if ! path=$(ipc_exchange '{"command":["get_property","metadata"]}'); then
    rm -f "$path"
    empty_icy_json
    return 0
  fi
  if ! reply=$(ipc_slurp "$path"); then
    empty_icy_json
    return 0
  fi
  icy_from_reply "$reply"
}

status_json() {
  local playing=false pid=0 url icy
  url=$(current_url)
  url_allowlisted "$url" || url="$default_url"
  if player_alive; then
    playing=true
    read -r pid _ < "$pid_file"
  else
    cleanup_dead_player
  fi
  icy=$(read_icy)
  jq -cn \
    --argjson playing "$playing" \
    --argjson pid "$pid" \
    --arg url "$url" \
    --arg title "$player_title" \
    --argjson icy "$icy" \
    '{playing:$playing,pid:$pid,url:$url,title:$title}
     + $icy'
}

reuse_running_player() {
  local url=$1
  [[ $(current_url) == "$url" ]] || return 1
  status_json
}

retarget_running_player() {
  local url=$1
  printf '%s\n' "$url" > "$url_file"
  send_command "$(jq -cn --arg u "$url" '{command:["loadfile",$u,"replace"]}')" >/dev/null || return 1
  status_json
}

spawn_mpv() {
  local url=$1
  setsid mpv \
    --no-video \
    --force-window=no \
    --audio-display=no \
    --idle=no \
    --loop-playlist=inf \
    --cache-secs=20 \
    --demuxer-max-bytes=8MiB \
    --demuxer-max-back-bytes=2MiB \
    --network-timeout=30 \
    --user-agent="$user_agent" \
    --title="$player_title" \
    --force-media-title="$player_title" \
    --input-ipc-server="$socket" \
    --no-terminal \
    --really-quiet \
    "$url" \
    >"$log_file" 2>&1 8>&- &
  printf '%s\n' "$!"
}

wait_for_socket() {
  local _
  for _ in $(seq 1 150); do
    [[ -S $socket ]] && return 0
    sleep 0.02
  done
  [[ -S $socket ]]
}

abort_start() {
  local player_pid=$1
  local message=$2
  kill -- "-$player_pid" 2>/dev/null || kill "$player_pid" 2>/dev/null || true
  wait "$player_pid" 2>/dev/null || true
  rm -f "$pid_file" "$socket"
  echo "$message" >&2
  exit 4
}

adopt_or_stop_running() {
  local url=$1
  player_alive || return 1
  reuse_running_player "$url" && return 0
  retarget_running_player "$url" && return 0
  terminate_tracked_player || true
  return 1
}

cmd_start() {
  local url=${1:-$default_url} player_pid
  url_allowlisted "$url" || { echo 'jradio-player: refusing non-allowlisted stream URL' >&2; exit 2; }

  flock -x 8
  if adopt_or_stop_running "$url"; then
    return 0
  fi

  printf '%s\n' "$url" > "$url_file"
  rm -f "$socket"
  player_pid=$(spawn_mpv "$url")
  write_player_pid "$player_pid" || abort_start "$player_pid" 'jradio-player: could not start mpv'
  if ! wait_for_socket && ! player_alive; then
    abort_start "$player_pid" "jradio-player: mpv exited early; see $log_file"
  fi
  status_json
}

cmd_stop() {
  flock -x 8
  terminate_tracked_player || true
  rm -f "$socket"
  status_json
}

cmd_toggle() {
  local url=${1:-}
  flock -x 8
  if player_alive; then
    terminate_tracked_player || true
    rm -f "$socket"
    status_json
  else
    flock -u 8
    cmd_start "${url:-$(current_url)}"
  fi
}

cmd_status() {
  flock -x 8
  status_json
}

case "${1:-}" in
  start) shift; cmd_start "${1:-$default_url}" ;;
  stop) cmd_stop ;;
  toggle) shift; cmd_toggle "${1:-}" ;;
  status) cmd_status ;;
  *)
    echo "Usage: jradio-player start [url] | stop | toggle [url] | status" >&2
    exit 1
    ;;
esac
