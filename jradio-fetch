#!/usr/bin/env bash
# Bounded HTTPS fetch helpers for ofs.jradio.
# Usage:
#   jradio-fetch meta
#   jradio-fetch art <https-url>
PATH=/usr/bin
unset BASH_ENV ENV
set -euo pipefail
umask 077

: "${XDG_RUNTIME_DIR:?jradio-fetch requires XDG_RUNTIME_DIR}"

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
version=$(jq -r '.version // "1.1.0"' "$script_dir/manifest.json" 2>/dev/null || echo "1.1.0")
user_agent="ofs.jradio/${version} (Omarchy Quattro; +https://jpopsuki.eu/media.php)"

# HTTPS-only Centova JSON. Fail closed on bad/mismatched certificates.
meta_url="https://jpopsuki.fm:2199/rpc/jpopsuki/streaminfo.get"
max_meta_bytes=65536
max_art_bytes=524288
max_art_edge=1024
max_meta_time=8
max_art_time=10

# Literal XDG paths so inspect resolves writes under $XDG_RUNTIME_DIR.
runtime_dir="$XDG_RUNTIME_DIR/ofs-jradio"
art_dir="$XDG_RUNTIME_DIR/ofs-jradio/art"
install -d -m 700 "$XDG_RUNTIME_DIR/ofs-jradio" "$XDG_RUNTIME_DIR/ofs-jradio/art"

is_https_url() {
  local url=$1
  [[ $url =~ ^https://[^[:space:]/]+ ]] || return 1
  [[ $url != *$'\n'* && $url != *$'\r'* && $url != *$'\0'* ]] || return 1
  (( ${#url} <= 512 )) || return 1
  return 0
}

art_host_allowed() {
  local host=$1
  host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
  [[ -n $host && $host != *..* ]] || return 1
  [[ $host == "lastfm.freetls.fastly.net" || $host == *.lastfm.freetls.fastly.net ]] && return 0
  [[ $host == "last.fm" || $host == *.last.fm ]] && return 0
  return 1
}

empty_meta_json() {
  jq -cn '{type:"result",data:[{title:"JPopsuki Radio",song:"",track:{},listeners:0,bitrate:"",offline:true,serverstate:false}]}'
}

curl_meta() {
  local response=$1
  curl -qfsS \
    --proto '=https' --proto-redir '=https' \
    --connect-timeout 4 --max-time "$max_meta_time" \
    --max-filesize "$max_meta_bytes" \
    -A "$user_agent" \
    -o "$response" \
    "$meta_url" 2>/dev/null
}

meta_body_ok() {
  local response=$1
  local size
  size=$(stat -c '%s' -- "$response" 2>/dev/null || echo 0)
  (( size > 0 && size <= max_meta_bytes )) || return 1
  jq -e '
    (.type == "result")
    and ((.data | type) == "array")
    and ((.data | length) >= 1)
    and ((.data | length) <= 4)
  ' "$response" >/dev/null 2>&1
}

project_meta() {
  local response=$1
  jq -c --argjson maxBytes "$max_meta_bytes" -f "$script_dir/meta-project.jq" "$response"
}

empty_art_json() {
  jq -cn '{path:""}'
}

art_path_json() {
  jq -cn --arg path "$1" '{path:$path}'
}

cmd_meta() {
  local response
  response=$(mktemp "$XDG_RUNTIME_DIR/ofs-jradio/meta.XXXXXX")
  if ! curl_meta "$response"; then
    rm -f "$response"
    empty_meta_json
    return 0
  fi
  if ! meta_body_ok "$response"; then
    rm -f "$response"
    empty_meta_json
    return 0
  fi
  project_meta "$response"
  rm -f "$response"
}

validate_image() {
  local path=$1
  python3 - "$path" "$max_art_edge" <<'PY'
import sys
from PIL import Image

path, max_edge = sys.argv[1], int(sys.argv[2])
allowed = {"JPEG", "PNG", "WEBP"}
try:
    with Image.open(path) as im:
        im.verify()
    with Image.open(path) as im:
        if im.format not in allowed:
            raise SystemExit(1)
        w, h = im.size
        if w <= 0 or h <= 0 or w > max_edge or h > max_edge:
            raise SystemExit(1)
        # Force a decode pass so truncated/malicious payloads fail here.
        im.load()
except Exception:
    raise SystemExit(1)
raise SystemExit(0)
PY
}

art_cache_hit() {
  local final=$1
  local existing
  [[ -s $final ]] || return 1
  existing=$(stat -c '%s' -- "$final" 2>/dev/null || echo 0)
  (( existing > 0 && existing <= max_art_bytes )) || return 1
  validate_image "$final"
}

prune_art_cache() {
  local old
  find "$XDG_RUNTIME_DIR/ofs-jradio/art" -type f -name '*.img' -printf '%T@ %p\n' 2>/dev/null \
    | sort -nr \
    | awk 'NR > 8 { print $2 }' \
    | while IFS= read -r old; do rm -f "$old"; done
}

fetch_art_body() {
  local url=$1
  local response=$2
  curl -qfsS \
    --proto '=https' --proto-redir '=https' \
    --connect-timeout 4 --max-time "$max_art_time" \
    --max-filesize "$max_art_bytes" \
    -A "$user_agent" \
    -o "$response" \
    "$url" 2>/dev/null
}

art_body_ok() {
  local response=$1
  local size
  size=$(stat -c '%s' -- "$response" 2>/dev/null || echo 0)
  (( size > 0 && size <= max_art_bytes )) || return 1
  validate_image "$response"
}

art_url_host() {
  printf '%s' "$1" | sed -E 's#^https://([^/:?#]+).*#\1#'
}

art_cache_key() {
  printf '%s' "$1" | sha256sum | awk '{print $1}'
}

download_art() {
  local url=$1
  local key=$2
  local response
  response=$(mktemp "$XDG_RUNTIME_DIR/ofs-jradio/art/fetch.XXXXXX")
  if ! fetch_art_body "$url" "$response" || ! art_body_ok "$response"; then
    rm -f "$response"
    return 1
  fi
  mv "$response" "$XDG_RUNTIME_DIR/ofs-jradio/art/$key.img"
  prune_art_cache
  return 0
}

cmd_art() {
  local url=${1:-} host key final
  if ! is_https_url "$url"; then empty_art_json; return 0; fi
  host=$(art_url_host "$url")
  if ! art_host_allowed "$host"; then empty_art_json; return 0; fi
  key=$(art_cache_key "$url")
  final="$XDG_RUNTIME_DIR/ofs-jradio/art/$key.img"
  if art_cache_hit "$final"; then art_path_json "$final"; return 0; fi
  rm -f "$final"
  if download_art "$url" "$key"; then art_path_json "$final"; else empty_art_json; fi
}

case "${1:-}" in
  meta) cmd_meta ;;
  art) shift; cmd_art "${1:-}" ;;
  *)
    echo "Usage: jradio-fetch meta | art <https-url>" >&2
    exit 1
    ;;
esac
